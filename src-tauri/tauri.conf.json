{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerDock",
  "version": "0.1.0",
  "identifier": "com.serverdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ServerDock — File Transfer & Large-File Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 650,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
